<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.campuscore</groupId>
    <artifactId>campuscore-java-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CampusCore Java modular monolith</name>
    <description>Canonical Spring Boot modular-monolith build for the CampusCore course migration</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <campuscore.java.range>[25,26)</campuscore.java.range>
        <campuscore.maven.range>[3.9,4.0)</campuscore.maven.range>
        <maven-enforcer-plugin.version>3.6.1</maven-enforcer-plugin.version>
        <postgresql.version>42.7.13</postgresql.version>
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <profiles>
        <profile>
            <id>java21-baseline</id>
            <activation>
                <property>
                    <name>campuscore.java-baseline</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <java.version>21</java.version>
                <maven.compiler.release>21</maven.compiler.release>
                <campuscore.java.range>[21,22)</campuscore.java.range>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-campuscore-toolchain</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>${campuscore.java.range}</version>
                                    <message>CampusCore requires Java ${campuscore.java.range}; use the explicit java21-baseline profile only for the Java 21 compatibility gate.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>${campuscore.maven.range}</version>
                                    <message>CampusCore requires Maven 3.9.x. Run ./mvnw or .\mvnw.cmd.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>restful-api</module>
    </modules>
</project>
