SERVER_PORT=4010
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campuscore?currentSchema=thesis
SPRING_DATASOURCE_USERNAME=campuscore
SPRING_DATASOURCE_PASSWORD=replace-with-a-secret
JWT_SECRET=replace-with-the-existing-access-token-secret
FLYWAY_ENABLED=true
ACCESS_TOKEN_COOKIE=cc_access_token
CSRF_COOKIE=cc_csrf
CSRF_HEADER=X-CSRF-Token
REDIS_URL=redis://localhost:6379
ASSISTANT_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=replace-with-provider-model
DEEPSEEK_API_KEY=replace-with-rotated-secret
ASSISTANT_MAX_REQUESTS_PER_MINUTE=20
ASSISTANT_MAX_MESSAGE_LENGTH=2000
