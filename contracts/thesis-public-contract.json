{
  "basePath": "/api/v1/thesis",
  "endpoints": [
    { "method": "GET", "path": "/rounds", "clientSource": "api.get<ThesisRound[]>('/thesis/rounds')" },
    { "method": "POST", "path": "/rounds" },
    { "method": "POST", "path": "/rounds/{id}/open-registration" },
    { "method": "POST", "path": "/rounds/{id}/close-registration" },
    { "method": "POST", "path": "/rounds/{id}/publish-proposals" },
    { "method": "GET", "path": "/topics", "clientSource": "api.get<ThesisTopic[]>('/thesis/topics'" },
    { "method": "POST", "path": "/topics" },
    { "method": "POST", "path": "/topics/{id}/publish" },
    { "method": "GET", "path": "/groups", "clientSource": "api.get<ThesisGroup[]>('/thesis/groups'" },
    { "method": "GET", "path": "/groups/{id}" },
    { "method": "POST", "path": "/groups", "clientSource": "api.post<ThesisGroup>('/thesis/groups', {" },
    { "method": "POST", "path": "/groups/{id}/members", "clientSource": "api.post<ThesisGroup>(`/thesis/groups/${groupId}/members`" },
    { "method": "POST", "path": "/groups/{id}/topic", "clientSource": "api.post<ThesisGroup>(`/thesis/groups/${groupId}/topic`" },
    { "method": "POST", "path": "/groups/{id}/decision" },
    { "method": "GET", "path": "/councils", "clientSource": "api.get<ThesisCouncil[]>('/thesis/councils'" },
    { "method": "POST", "path": "/councils" },
    { "method": "POST", "path": "/councils/{id}/members" },
    { "method": "POST", "path": "/councils/{id}/schedule" },
    { "method": "POST", "path": "/councils/{id}/open-scoring" },
    { "method": "POST", "path": "/reviews" },
    { "method": "POST", "path": "/results/publish" },
    { "method": "POST", "path": "/assistant/chat", "clientSource": "api.post<AssistantReply>('/thesis/assistant/chat'" }
  ],
  "gateway": {
    "enabledRoute": "/api/v1/thesis",
    "enabledPrefixRoute": "/api/v1/thesis/",
    "disabledUpstreamMarker": "thesis_service_upstream",
    "disabledProxyMarker": "proxy_pass"
  }
}
