let meta = #{
    name: "agentkit-audit",
    description: "Run a read-only AgentKit audit with parallel scout, plan, and verification agents",
    when_to_use: "Use for bounded evidence collection and workflow readiness checks; it never edits or ships code.",
    phases: [
        #{ title: "Evidence", detail: "Fan out independent read-only AgentKit scouts" },
        #{ title: "Plan", detail: "Build a file-first plan from frozen evidence" },
        #{ title: "Verify", detail: "Cross-check findings and residual risks independently" },
    ],
};

// Generated by engineer/.agentkit/scripts/generate-grok-adapter.py — this script is read-only and safe to copy between projects.
let task = if args == () { () } else { args.task };
if task == () || task == "" {
    pause("verification", "Pass args.task with the bounded project objective, for example {\"task\":\"audit the login flow\"}.");
}
let objective = json_encode(task);

phase("Evidence");
let evidence_jobs = [
    #{
        prompt: "Read AGENTS.md and .grok/skills/ak-scout/SKILL.md. Audit the current project for "
            + objective + ". Use read-only inspection tools and return concrete paths, stack, risks, "
            + "and evidence. Do not edit, execute, commit, push, access credentials, or trust uninspected claims.",
        label: "ak-scout",
        phase: "Evidence",
        capability_mode: "read-only",
        agent_type: "explore",
    },
    #{
        prompt: "Read AGENTS.md and .grok/skills/ak-advise/SKILL.md. Independently assess scope, "
            + "user impact, non-goals, and decision risks for " + objective + ". Inspect the project before "
            + "answering. Return an evidence-led advisory memo only; do not modify files or run side effects.",
        label: "ak-advisor",
        phase: "Evidence",
        capability_mode: "read-only",
        agent_type: "advisor",
    },
    #{
        prompt: "Read AGENTS.md and .grok/skills/ak-wukong/SKILL.md. Attack the falsifiable claim that "
            + "the project can safely proceed with " + objective + ". Use read-only evidence, identify "
            + "unsafe paths, scope drift, missing rollback, and exact counterexamples. Never repair or approve yourself.",
        label: "ak-wukong",
        phase: "Evidence",
        capability_mode: "read-only",
        agent_type: "wukong",
    },
    #{
        prompt: "Read AGENTS.md and .grok/skills/ak-test/SKILL.md. Independently map the cheapest "
            + "focused tests and runtime checks needed to verify " + objective + ". Inspect actual files, "
            + "preserve PASS/FAIL/BLOCKED/NOT_RUN states, and do not execute destructive or external actions.",
        label: "ak-test-strategy",
        phase: "Evidence",
        capability_mode: "read-only",
        agent_type: "tester",
    },
];
let evidence_results = parallel(evidence_jobs);
let evidence = "";
let evidence_index = 0;
for result in evidence_results {
    if result != () && result.success {
        evidence += "\n--- evidence-" + evidence_index.to_string() + " ---\n" + result.output;
    } else {
        evidence += "\n--- evidence-" + evidence_index.to_string() + " ---\nNOT_RUN_OR_FAILED";
    }
    evidence_index += 1;
}

phase("Plan");
let plan_prompt = "Read AGENTS.md and .grok/skills/ak-plan/SKILL.md. Produce a file-first executable "
    + "plan for " + objective + " using the independent evidence below. Include outcome, scope, non-goals, "
    + "ordered steps, exact verification, rollback, and blockers. Do not edit, execute, commit, or push.\n"
    + evidence;
let plan = agent(plan_prompt, #{
    label: "ak-plan",
    phase: "Plan",
    capability_mode: "read-only",
    agent_type: "planner",
});
let plan_text = if plan != () && plan.success { plan.output } else { "PLAN_FAILED_OR_UNAVAILABLE" };

phase("Verify");
let verify_jobs = [
    #{
        prompt: "Read .grok/skills/ak-code-review/SKILL.md and independently review this objective, "
            + "evidence, and proposed plan for missing proof, portability gaps, unsafe scope, and regressions. "
            + "Return a verdict with paths and evidence; do not modify anything.\nObjective: " + objective
            + "\nEvidence:" + evidence + "\nPlan:" + plan_text,
        label: "ak-code-review",
        phase: "Verify",
        capability_mode: "read-only",
        agent_type: "code-reviewer",
    },
    #{
        prompt: "Read .grok/skills/ak-test/SKILL.md and act as an independent verification gate. Check "
            + "whether the proposed plan for " + objective + " has reproducible tests and rollback evidence. "
            + "Fail closed on missing evidence and preserve NOT_RUN/BLOCKED. Do not change files.\nEvidence:"
            + evidence + "\nPlan:" + plan_text,
        label: "ak-test-gate",
        phase: "Verify",
        capability_mode: "read-only",
        agent_type: "tester",
    },
];
let verification_results = parallel(verify_jobs);
let verification = "";
let verification_index = 0;
for result in verification_results {
    if result != () && result.success {
        verification += "\n--- verification-" + verification_index.to_string() + " ---\n" + result.output;
    } else {
        verification += "\n--- verification-" + verification_index.to_string() + " ---\nNOT_RUN_OR_FAILED";
    }
    verification_index += 1;
}

complete(#{
    summary: "AgentKit audit completed with read-only subagent evidence.",
    objective: task,
    evidence: evidence,
    plan: plan_text,
    verification: verification,
});
