# Copy to .env.production on the VPS and replace every placeholder.
# This file intentionally contains no credentials and is safe to track.
CAMPUSCORE_IMAGE_TAG=replace-with-reviewed-40-char-main-sha
CAMPUSCORE_DOMAIN=campus.example.edu
ACME_EMAIL=ops@example.edu
POSTGRES_USER=campuscore
POSTGRES_DB=campuscore_restful

# Keep false until a newly rotated DeepSeek key is provisioned in
# ops/secrets/deepseek_api_key. The browser never receives this value.
DEEPSEEK_ENABLED=false
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=8000
DEEPSEEK_MAX_OUTPUT_TOKENS=800

# Supabase is the production authoring/publish source. Set true only after
# the protected assistant schema and service-role file have been verified.
ASSISTANT_SUPABASE_ENABLED=false
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SCHEMA=assistant

ASSISTANT_MAX_MESSAGE_CHARS=2000
ASSISTANT_MAX_CONTEXT_CHARS=6000
ASSISTANT_USER_DAILY_QUOTA=20
ASSISTANT_GLOBAL_DAILY_QUOTA=200
ASSISTANT_RETENTION_DAYS=90
