# Public site URL used for canonical metadata, sitemap, and manifest generation.
NEXT_PUBLIC_SITE_URL=https://tienson.io.vn

# Java REST API base URL used by browser requests.
# Use http://127.0.0.1:4010/api/v1 for the local course demo, or keep /api/v1
# when the web app and Java API are served behind the same origin.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4010/api/v1
