# PostgreSQL
POSTGRES_USER=campuscore
POSTGRES_PASSWORD=replace-with-a-local-course-password
POSTGRES_DB=campuscore_restful
POSTGRES_HOST_PORT=5432

# Java REST API
RESTFUL_API_HOST_PORT=4010
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
HEALTH_READINESS_KEY=replace-with-a-local-readiness-key
COOKIE_SECURE=false
FLYWAY_ENABLED=true

# Next.js and Expo clients
NEXT_PUBLIC_API_URL=http://127.0.0.1:4010/api/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:4010/api/v1
EXPO_PUBLIC_API_MODE=live
