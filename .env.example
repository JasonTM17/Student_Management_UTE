# PostgreSQL
POSTGRES_USER=campuscore
POSTGRES_PASSWORD=replace-with-a-local-course-password
POSTGRES_DB=campuscore_restful
POSTGRES_HOST_PORT=5432

# Java REST API
RESTFUL_API_HOST_PORT=4010
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
HEALTH_READINESS_KEY=replace-with-a-local-readiness-key
COOKIE_SECURE=false
FLYWAY_ENABLED=true
# Local and existing CampusCore databases use only db/migration. A brand-new
# reviewed Supabase target additionally uses classpath:db/supabase-baseline;
# see docs/integrations/supabase-database.md before changing this value.
FLYWAY_LOCATIONS=classpath:db/migration

# Auth mail. Docker Compose reaches Mailpit by service name; use localhost only
# when the Java API itself runs directly on the host.
MAIL_ENABLED=true
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=replace-with-smtp-username
SPRING_MAIL_PASSWORD=replace-with-smtp-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@campuscore.local
AUTH_FRONTEND_BASE_URL=http://localhost:3000
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_MAX_CHALLENGE_ATTEMPTS=5
AUTH_MAX_REQUESTS_PER_DAY=5
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# Thesis RAG provider (server-only; keep disabled until a rotated key is set)
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=replace-with-a-rotated-runtime-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=8000
DEEPSEEK_MAX_OUTPUT_TOKENS=800
ASSISTANT_MAX_MESSAGE_CHARS=2000
ASSISTANT_MAX_CONTEXT_CHARS=6000
ASSISTANT_USER_DAILY_QUOTA=20
ASSISTANT_GLOBAL_DAILY_QUOTA=200
ASSISTANT_RETENTION_DAYS=90

# Next.js and Expo clients
NEXT_PUBLIC_API_URL=http://127.0.0.1:4010/api/v1
# Android Emulator uses 10.0.2.2. Physical devices must use the host LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4010/api/v1
EXPO_PUBLIC_API_MODE=live
